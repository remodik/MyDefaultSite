DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

SECRET_KEY=your-secret-key-here
FRONTEND_URL=your-domain-url
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
SBP_PHONE=+79001234567
SBP_BANK=Тинькофф
SBP_RECIPIENT=Иванов Иван Иванович
LICENSE_SECRET=случайная_строка_32+_символов
LICENSE_ADMIN_SECRET=секрет_для_генерации_ключей
GOOGLE_CLIENT_ID=ваш-client-id.apps.googleusercontent.com

# S3-совместимое хранилище аватарок (Selectel Object Storage).
# Если не задано — аватарки сохраняются на локальный диск (эфемерный на Render).
# Бакет должен быть публичным на чтение.
S3_ENDPOINT_URL=https://s3.ru-1.storage.selcloud.ru
S3_ACCESS_KEY=ваш-access-key
S3_SECRET_KEY=ваш-secret-key
S3_BUCKET=имя-бакета
S3_REGION=ru-1
# Необязательно: свой публичный домен/CDN бакета (по умолчанию {endpoint}/{bucket})
S3_PUBLIC_URL_BASE=